{
  "name": "@kaki/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared platform services: config, logging, telemetry, tokens, queues, outbox, pub/sub, PII masking (architecture \u00a75.2).",
  "exports": {
    ".": "./src/index.ts",
    "./outbox": "./src/outbox.ts",
    "./pii-mask": "./src/pii-mask.ts",
    "./secrets": "./src/secrets.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1152.0",
    "@kaki/db": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "iovalkey": "0.4.0",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "testcontainers": "12.2.1",
    "vitest": "5.0.5"
  }
}
