{
  "name": "@kaki/channels",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ChannelAdapter contract, the website widget's settings, allowed origins and install check, and the DOM-only widget theme module (ADR-011, ADR-016).",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@kaki/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  }
}
