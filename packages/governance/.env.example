# `pnpm audit:verify` (packages/governance/scripts/verify-audit.ts). Locally generated
# into .env by scripts/gen-local-env.mjs.
AWS_REGION=ap-southeast-1
# LocalStack locally; leave empty in AWS
AWS_ENDPOINT_URL=http://localhost:4566
AUDIT_ANCHOR_BUCKET=kaki-local-audit-anchors

# --- secrets ---
DASHBOARD_DATABASE_URL=postgres://app_dashboard:<password>@localhost:5432/kakiagent
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
