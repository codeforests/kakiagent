# Used by `pnpm db:setup` (roles, migrations, seed). Locally generated by scripts/gen-local-env.mjs.
DATABASE_OWNER_URL=postgres://kaki_owner:<password>@localhost:5432/kakiagent
SEED_DEV_TENANTS=true
# Comma-separated origins allowed to load the widget for the seeded dev tenants.
WIDGET_DEV_ORIGINS=http://localhost:5175

# --- secrets ---
APP_DASHBOARD_PASSWORD=<password>
APP_AGENT_VISITOR_PASSWORD=<password>
APP_OUTBOX_PASSWORD=<password>
APP_IDENTITY_PASSWORD=<password>
APP_INGEST_PASSWORD=<password>
