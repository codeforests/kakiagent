{
  "name": "@kaki/scheduler-worker",
  "private": true,
  "type": "module",
  "description": "Runtime role: the outbox dispatcher and audit anchoring now; durable timers and other recurring jobs later (ADR-012, ADR-014).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node ../../scripts/bundle-node.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit --passWithNoTests"
  },
  "dependencies": {
    "@kaki/analytics": "workspace:*",
    "@kaki/db": "workspace:*",
    "@kaki/governance": "workspace:*",
    "@kaki/identity": "workspace:*",
    "@kaki/kb": "workspace:*",
    "@kaki/platform": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
