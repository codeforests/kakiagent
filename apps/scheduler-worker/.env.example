# scheduler-worker role. Locally generated into .env by scripts/gen-local-env.mjs.
NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=3004
AWS_REGION=ap-southeast-1
# LocalStack locally; leave empty in AWS
AWS_ENDPOINT_URL=http://localhost:4566
SQS_TURNS_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/conversation-turns.fifo
SQS_INGEST_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/ingest.fifo
OUTBOX_SWEEP_MS=5000
# S3 Object Lock bucket for audit chain heads (ADR-014); kaki-local-audit-anchors in LocalStack
AUDIT_ANCHOR_BUCKET=kaki-local-audit-anchors
AUDIT_ANCHOR_INTERVAL_MS=900000
# The dashboard origin the sign-in links open; Mailpit locally, the SES SMTP endpoint in AWS
PUBLIC_APP_URL=http://localhost:5173
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=KakiAgent <no-reply@kakiagent.local>
MAGIC_LINK_SWEEP_MS=5000
# Cost governor (ADR-007, FEAT-004): hourly; raise a step above the target per conversation,
# relax below the relax limit; tenants with fewer conversations in 7 days are left alone
COST_GOVERNOR_INTERVAL_MS=3600000
COST_GOVERNOR_TARGET_SGD=0.025
COST_GOVERNOR_RELAX_SGD=0.02
USD_SGD_RATE=1.35
COST_GOVERNOR_MIN_CONVERSATIONS=20
# Stale-fact scan (KB-17, FEAT-018): daily, first run at start-up
STALE_SCAN_INTERVAL_MS=86400000
# Coverage-gap grouping (KB-09, FEAT-019): every 10 minutes, first run at start-up
GAP_CLUSTER_INTERVAL_MS=600000
# Channel health checks (CHN-12, FEAT-034): every 5 minutes, first run at start-up
CHANNEL_HEALTH_INTERVAL_MS=300000
# Auto-close of idle conversations (INB-08, FEAT-042): every minute, first run at start-up
AUTO_CLOSE_INTERVAL_MS=60000
# optional: OTLP endpoint of the ADOT collector (prod only)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- secrets ---
OUTBOX_DATABASE_URL=postgres://app_outbox:<password>@localhost:5432/kakiagent
IDENTITY_DATABASE_URL=postgres://app_identity:<password>@localhost:5432/kakiagent
# must equal the api's value
MAGIC_LINK_SECRET=<at least 32 random characters>
