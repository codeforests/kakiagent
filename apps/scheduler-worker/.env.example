# scheduler-worker role. Locally generated into .env by scripts/gen-local-env.mjs.
NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=3004
AWS_REGION=ap-southeast-1
# LocalStack locally; leave empty in AWS
AWS_ENDPOINT_URL=http://localhost:4566
SQS_TURNS_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/conversation-turns.fifo
OUTBOX_SWEEP_MS=5000
# S3 Object Lock bucket for audit chain heads (ADR-014); kaki-local-audit-anchors in LocalStack
AUDIT_ANCHOR_BUCKET=kaki-local-audit-anchors
AUDIT_ANCHOR_INTERVAL_MS=900000
# The dashboard origin the sign-in links open; Mailpit locally, the SES SMTP endpoint in AWS
PUBLIC_APP_URL=http://localhost:5173
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=KakiAgent <no-reply@kakiagent.local>
MAGIC_LINK_SWEEP_MS=5000
# optional: OTLP endpoint of the ADOT collector (prod only)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- secrets ---
OUTBOX_DATABASE_URL=postgres://app_outbox:<password>@localhost:5432/kakiagent
IDENTITY_DATABASE_URL=postgres://app_identity:<password>@localhost:5432/kakiagent
# must equal the api's value
MAGIC_LINK_SECRET=<at least 32 random characters>
