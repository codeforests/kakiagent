{
  "name": "@kaki/agent-worker",
  "private": true,
  "type": "module",
  "description": "Runtime role: consumes conversation turns from SQS and runs them through the agent and llm-gateway (ADR-007, ADR-012).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node ../../scripts/bundle-node.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit --passWithNoTests",
    "email:receive": "node --env-file-if-exists=.env scripts/email-receive.mjs",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@kaki/agent": "workspace:*",
    "@kaki/analytics": "workspace:*",
    "@kaki/approvals": "workspace:*",
    "@kaki/channels": "workspace:*",
    "@kaki/contracts": "workspace:*",
    "@kaki/db": "workspace:*",
    "@kaki/governance": "workspace:*",
    "@kaki/inbox": "workspace:*",
    "@kaki/llm-gateway": "workspace:*",
    "@kaki/platform": "workspace:*",
    "@kaki/tenancy": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
