# agent-worker role. Locally generated into .env by scripts/gen-local-env.mjs.
NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=3002
AWS_REGION=ap-southeast-1
# LocalStack locally; leave empty in AWS
AWS_ENDPOINT_URL=http://localhost:4566
SQS_TURNS_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/conversation-turns.fifo
VALKEY_URL=redis://localhost:6379
# fake | anthropic-dev (test data only; architecture Q1)
LLM_PROVIDER=fake
# optional: OTLP endpoint of the ADOT collector (prod only)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- secrets ---
VISITOR_DATABASE_URL=postgres://app_agent_visitor:<password>@localhost:5432/kakiagent
# dev only, with LLM_PROVIDER=anthropic-dev
ANTHROPIC_API_KEY=
