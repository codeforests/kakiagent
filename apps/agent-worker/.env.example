# agent-worker role. Locally generated into .env by scripts/gen-local-env.mjs.
NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=3002
AWS_REGION=ap-southeast-1
# LocalStack locally; leave empty in AWS
AWS_ENDPOINT_URL=http://localhost:4566
SQS_TURNS_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/conversation-turns.fifo
VALKEY_URL=redis://localhost:6379
# Inbound email (FEAT-036): SES stores mail for in.<domain> in the bucket and notifies the
# SNS topic, which feeds the queue; attachments wait in quarantine for the scan
EMAIL_INBOUND_DOMAIN=in.kaki.test
EMAIL_INBOUND_BUCKET=kaki-local-inbound-mail
EMAIL_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:000000000000:email-inbound
SQS_EMAIL_INBOUND_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/email-inbound
QUARANTINE_BUCKET=kaki-local-quarantine
# Adapter-channel replies (FEAT-036): the channel-send queue, and SMTP (Mailpit locally, the
# SES SMTP endpoint at MD); SES rewrites Message-IDs to <id>@<SES_MESSAGE_ID_DOMAIN>
SQS_CHANNEL_SEND_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/channel-send.fifo
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=KakiAgent <no-reply@kakiagent.local>
SES_MESSAGE_ID_DOMAIN=ap-southeast-1.amazonses.com
# fake | anthropic-dev | openai-compat (dev providers carry test data only; architecture Q1)
LLM_PROVIDER=fake
# openai-compat: any Chat Completions endpoint. NVIDIA API catalog (free tier) example:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL_SMALL=deepseek-ai/deepseek-v4.1-flash
LLM_BASE_URL=
# triage, simple replies, mining, summaries
LLM_MODEL_SMALL=
# complex replies and extraction (default: the small model)
LLM_MODEL_LARGE=
# eval judging (default: the large model)
LLM_MODEL_JUDGE=
# json_object | json_schema | none; the schema is also always in the prompt
LLM_JSON_MODE=json_object
# provider-specific request fields as JSON, e.g. {"chat_template_kwargs":{"thinking":false}}
LLM_EXTRA_BODY=
# USD per million tokens per tier as JSON, e.g. {"small":{"input":0.15,"cacheRead":0.003,"output":0.6}}; zero when unset
LLM_PRICES=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# optional: OTLP endpoint of the ADOT collector (prod only)
OTEL_EXPORTER_OTLP_ENDPOINT=

# the Telegram Bot API; locally the fake (pnpm fixtures:telegram, FEAT-037)
TELEGRAM_API_BASE=http://localhost:5177

# --- secrets ---
VISITOR_DATABASE_URL=postgres://app_agent_visitor:<password>@localhost:5432/kakiagent
# dev only, with LLM_PROVIDER=anthropic-dev
ANTHROPIC_API_KEY=
# dev only, with LLM_PROVIDER=openai-compat (an NVIDIA API catalog key is nvapi-…)
LLM_API_KEY=
# 32 random bytes, base64url: opens channel credentials (FEAT-037); the same as the api's
CHANNEL_SECRET_KEY=<32 random bytes, base64url>
