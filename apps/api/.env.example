# api role. Locally generated into .env by scripts/gen-local-env.mjs; in AWS set by the task definition (MD).
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0
VALKEY_URL=redis://localhost:6379
PUBLIC_REALTIME_URL=http://localhost:3001
PUBLIC_WIDGET_PANEL_URL=http://localhost:5175/w/v1/panel.js
# FEAT-032: the snippet's loader, the dashboard's widget preview, and this api's public origin
PUBLIC_WIDGET_LOADER_URL=http://localhost:5175/w/v1/loader.js
PUBLIC_WIDGET_PREVIEW_URL=http://localhost:5175/w/v1/preview.html
PUBLIC_API_URL=http://localhost:3000
# The dashboard origin: magic links, the Google redirect URI and the Origin check (FEAT-005)
PUBLIC_APP_URL=http://localhost:5173
# Mailpit locally; the SES SMTP endpoint in AWS (MD)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=KakiAgent <no-reply@kakiagent.local>
# false only for local HTTP: the session cookie is Secure everywhere else
COOKIE_SECURE=true
# the issuer name authenticator apps show (FEAT-006)
APP_NAME=KakiAgent
# optional: Google sign-in is offered only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_ISSUER=https://accounts.google.com
# fake | anthropic-dev | openai-compat (test data only; Q1). The api runs coaching turns and
# embeds fact chunks, which stay on the fake embedder (FEAT-022 D5)
LLM_PROVIDER=fake
# openai-compat: any Chat Completions endpoint. NVIDIA API catalog (free tier) example:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL_SMALL=deepseek-ai/deepseek-v4.1-flash
LLM_BASE_URL=
# triage, simple replies, mining, summaries
LLM_MODEL_SMALL=
# complex replies and extraction (default: the small model)
LLM_MODEL_LARGE=
# eval judging (default: the large model)
LLM_MODEL_JUDGE=
# json_object | json_schema | none; the schema is also always in the prompt
LLM_JSON_MODE=json_object
# provider-specific request fields as JSON, e.g. {"chat_template_kwargs":{"thinking":false}}
LLM_EXTRA_BODY=
# USD per million tokens per tier as JSON, e.g. {"small":{"input":0.15,"cacheRead":0.003,"output":0.6}}; zero when unset
LLM_PRICES=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
# optional: OTLP endpoint of the ADOT collector (prod only)
OTEL_EXPORTER_OTLP_ENDPOINT=
# the page limit a new website source gets, until plans exist (FEAT-012 D8)
CRAWL_PAGE_LIMIT=100
# the file sources a tenant may have, until plans exist (FEAT-015 D2)
FILE_LIMIT=50
# browsers PUT uploads here through presigned URLs (FEAT-015)
QUARANTINE_BUCKET=kaki-local-quarantine
AWS_REGION=ap-southeast-1
# LocalStack locally; leave empty in AWS
AWS_ENDPOINT_URL=http://localhost:4566
# dev only: accept website hosts on private addresses (the fixture site); ignored in production builds
CRAWL_ALLOW_PRIVATE_HOSTS=false

# --- secrets ---
DASHBOARD_DATABASE_URL=postgres://app_dashboard:<password>@localhost:5432/kakiagent
VISITOR_DATABASE_URL=postgres://app_agent_visitor:<password>@localhost:5432/kakiagent
VISITOR_TOKEN_SECRET=<at least 32 random characters>
SESSION_SECRET=<at least 32 random characters>
IDENTITY_DATABASE_URL=postgres://app_identity:<password>@localhost:5432/kakiagent
MAGIC_LINK_SECRET=<at least 32 random characters>
# 32 random bytes, base64url: seals TOTP secrets (FEAT-006)
MFA_SECRET_KEY=<32 random bytes, base64url>
GOOGLE_CLIENT_SECRET=
# dev only, with LLM_PROVIDER=anthropic-dev
ANTHROPIC_API_KEY=
# dev only, with LLM_PROVIDER=openai-compat (an NVIDIA API catalog key is nvapi-…)
LLM_API_KEY=
