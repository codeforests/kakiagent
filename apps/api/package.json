{
  "name": "@kaki/api",
  "private": true,
  "type": "module",
  "description": "Runtime role: REST for the dashboard, the widget API and (later) channel webhooks (ADR-001, ADR-002).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node ../../scripts/bundle-node.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@fastify/cookie": "11.1.3",
    "@kaki/agent": "workspace:*",
    "@kaki/analytics": "workspace:*",
    "@kaki/approvals": "workspace:*",
    "@kaki/channels": "workspace:*",
    "@kaki/contracts": "workspace:*",
    "@kaki/db": "workspace:*",
    "@kaki/design-tokens": "workspace:*",
    "@kaki/governance": "workspace:*",
    "@kaki/identity": "workspace:*",
    "@kaki/inbox": "workspace:*",
    "@kaki/kb": "workspace:*",
    "@kaki/llm-gateway": "workspace:*",
    "@kaki/platform": "workspace:*",
    "@kaki/tenancy": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/localstack": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
