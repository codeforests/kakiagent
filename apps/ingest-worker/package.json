{
  "name": "@kaki/ingest-worker",
  "private": true,
  "type": "module",
  "description": "Runtime role: crawl, extract and promote website sources (ADR-018, FEAT-012); parsing and OCR follow with FEAT-015.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node ../../scripts/bundle-node.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src fixtures test",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "fixtures:site": "tsx fixtures/main.ts",
    "fixtures:files": "tsx fixtures/files/generate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@kaki/analytics": "workspace:*",
    "@kaki/contracts": "workspace:*",
    "@kaki/db": "workspace:*",
    "@kaki/kb": "workspace:*",
    "@kaki/llm-gateway": "workspace:*",
    "@kaki/platform": "workspace:*",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/localstack": "12.2.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
