{
  "name": "@kaki/ingest-worker",
  "private": true,
  "type": "module",
  "description": "Runtime role: crawl, parse, OCR, extract, embed (ADR-018). Idle in the walking skeleton; FEAT-012 gives it work.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node ../../scripts/bundle-node.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --project unit --passWithNoTests"
  },
  "dependencies": {
    "@kaki/platform": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
