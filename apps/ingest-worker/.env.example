# ingest-worker role. Locally generated into .env by scripts/gen-local-env.mjs.
NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=3003
AWS_REGION=ap-southeast-1
# LocalStack locally; leave empty in AWS
AWS_ENDPOINT_URL=http://localhost:4566
SQS_INGEST_QUEUE_URL=http://sqs.ap-southeast-1.localhost.localstack.cloud:4566/000000000000/ingest.fifo
# fake | anthropic-dev (test data only; architecture Q1)
LLM_PROVIDER=fake
# pages fetched at once per source, pages extracted at once (ADR-018 d4)
CRAWL_CONCURRENCY=4
EXTRACT_CONCURRENCY=4
# one below the ingest queue's maxReceiveCount (6)
INGEST_MAX_ATTEMPTS=5
# dev only: lift the crawler's private-address guard (FEAT-012 §5.6); ignored in production builds
CRAWL_ALLOW_PRIVATE_HOSTS=false
# dev only: serve a domain from elsewhere, e.g. kakibakery.test=http://127.0.0.1:5176 (the fixture site)
CRAWL_HOST_MAP=
# optional: a Chromium binary; empty uses playwright-core's own (`playwright-core install chromium`)
CHROMIUM_EXECUTABLE_PATH=
# the widget build's public folder: theme detection fetches detect.js from here (FEAT-032)
WIDGET_ASSET_URL=http://localhost:5175/w/v1/
# FEAT-015: uploads wait in quarantine (deleted after 1 day); only clean files reach sources
QUARANTINE_BUCKET=kaki-local-quarantine
SOURCES_BUCKET=kaki-local-sources
# clamav (local, and ADR-019's fallback) | guardduty (AWS: reads GuardDuty's object tag)
MALWARE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
# the OCR binaries (Tesseract 5 with eng and chi_sim; poppler's pdftoppm)
TESSERACT_PATH=tesseract
PDFTOPPM_PATH=pdftoppm
# pages read and pages OCR'd per file, and OCR'd pages at once (FEAT-015 D8)
FILE_PAGE_LIMIT=200
OCR_PAGE_LIMIT=50
OCR_CONCURRENCY=2
# data rows read per spreadsheet (FEAT-016 D10)
SHEET_ROW_LIMIT=2000
# chat exports (FEAT-017): messages read (latest kept) and conversation parts mined
CHAT_MESSAGE_LIMIT=20000
CHAT_PART_LIMIT=200
# optional: OTLP endpoint of the ADOT collector (prod only)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- secrets ---
INGEST_DATABASE_URL=postgres://app_ingest:<password>@localhost:5432/kakiagent
# dev only, with LLM_PROVIDER=anthropic-dev
ANTHROPIC_API_KEY=
