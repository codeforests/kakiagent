# Optional: `pnpm eval` reads the envSchemas.llm variables from the environment or from
# evals/.env (gitignored). Unset, the eval set plays recorded outputs on the fake provider.
# Test data only (architecture Q1): the fixture tenants are synthetic.
LLM_PROVIDER=fake
# NVIDIA API catalog (free tier) example:
#   LLM_PROVIDER=openai-compat
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL_SMALL=deepseek-ai/deepseek-v4.1-flash
#   LLM_API_KEY=nvapi-…
LLM_BASE_URL=
LLM_MODEL_SMALL=
LLM_MODEL_LARGE=
LLM_MODEL_JUDGE=
LLM_JSON_MODE=json_object
LLM_EXTRA_BODY=
LLM_PRICES=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# --- secrets ---
ANTHROPIC_API_KEY=
LLM_API_KEY=
