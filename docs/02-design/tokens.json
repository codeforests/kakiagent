    "pending": {
      "default": {
        "$type": "color",
        "$value": "#6D28D9",
        "$description": "Waiting for approval",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#C4B5FD"
          }
        }
      },
      "soft": {
        "$type": "color",
        "$value": "#F1EAFD",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#2A1F45"
          }
        }
      }
    },
    "conversation": {
      "ai-fg": {
        "$type": "color",
        "$value": "{color.accent.default}",
        "$description": "INB-08 AI-handling"
      },
      "ai-bg": {
        "$type": "color",
        "$value": "{color.accent.soft}"
      },
      "escalated-fg": {
        "$type": "color",
        "$value": "{color.warning.default}",
        "$description": "INB-08 escalated"
      },
      "escalated-bg": {
        "$type": "color",
        "$value": "{color.warning.soft}"
      },
      "human-fg": {
        "$type": "color",
        "$value": "{color.info.default}",
        "$description": "INB-08 human"
      },
      "human-bg": {
        "$type": "color",
        "$value": "{color.info.soft}"
      },
      "approval-fg": {
        "$type": "color",
        "$value": "{color.pending.default}",
        "$description": "INB-08 waiting-for-approval"
      },
      "approval-bg": {
        "$type": "color",
        "$value": "{color.pending.soft}"
      },
      "closed-fg": {
        "$type": "color",
        "$value": "{color.text.secondary}",
        "$description": "INB-08 closed"
      },
      "closed-bg": {
        "$type": "color",
        "$value": "{color.bg.subtle}"
      }
    },
    "fact": {
      "review-fg": {
        "$type": "color",
        "$value": "{color.warning.default}",
        "$description": "KB-16 needs review"
      },
      "review-bg": {
        "$type": "color",
        "$value": "{color.warning.soft}"
      },
      "approved-fg": {
        "$type": "color",
        "$value": "{color.success.default}",
        "$description": "KB-16 approved"
      },
      "approved-bg": {
        "$type": "color",
        "$value": "{color.success.soft}"
      },
      "conflict-fg": {
        "$type": "color",
        "$value": "{color.danger.default}",
        "$description": "KB-06 conflicted (blocked)"
      },
      "conflict-bg": {
        "$type": "color",
        "$value": "{color.danger.soft}"
      },
      "rejected-fg": {
        "$type": "color",
        "$value": "{color.text.secondary}",
        "$description": "KB-16 rejected / disabled"
      },
      "rejected-bg": {
        "$type": "color",
        "$value": "{color.bg.subtle}"
      }
