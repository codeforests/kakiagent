{
  "$description": "KakiAgent design tokens (W3C DTCG). Direction: Harbour. Light values are in $value; dark values are in $extensions[\"org.kakiagent.modes\"].dark. design.md section 2 is generated from this file. Do not edit values in one place only.",
  "color": {
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "#F5F7F9",
        "$description": "Page background behind cards",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#0B1117"
          }
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Cards, panels, inputs, dialogs",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#121A22"
          }
        }
      },
      "subtle": {
        "$type": "color",
        "$value": "#EEF2F5",
        "$description": "Table header, hover row, source-passage well",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#18222C"
          }
        }
      },
      "scrim": {
        "$type": "color",
        "$value": "#0F172099",
        "$description": "Overlay behind dialogs and sheets (60% alpha)",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#000000B3"
          }
        }
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#D9E0E7",
        "$description": "Dividers and card outlines (decorative, no contrast requirement)",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#243241"
          }
        }
      },
      "strong": {
        "$type": "color",
        "$value": "#7D8C9B",
        "$description": "Input, checkbox and toggle outlines (>= 3:1, WCAG 1.4.11)",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#56697D"
          }
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#0F1720",
        "$description": "Headings and body",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#E6EDF3"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#5B6B7C",
        "$description": "Labels, metadata, help text",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#94A3B8"
          }
        }
      },
      "disabled": {
        "$type": "color",
        "$value": "#94A3B8",
        "$description": "Disabled text only (exempt from contrast)",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#5B6B7C"
          }
        }
      },
      "on-accent": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$description": "Text and icons on accent fills",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#0B1117"
          }
        }
      },
      "link": {
        "$type": "color",
        "$value": "{color.accent.default}",
        "$description": "Inline links (always underlined)"
      }
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": "#0E7490",
        "$description": "Primary actions, selected nav, links",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#4CC3D9"
          }
        }
      },
      "hover": {
        "$type": "color",
        "$value": "#0B5F76",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#6FD3E5"
          }
        }
      },
      "active": {
        "$type": "color",
        "$value": "#094E61",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#93E0EE"
          }
        }
      },
      "soft": {
        "$type": "color",
        "$value": "#E0F2F6",
