      "$type": "color",
      "$value": "{color.accent.default}",
      "$description": "Replaced by the detected host brand colour after the contrast clamp"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.bg.surface}"
    },
    "subtle": {
      "$type": "color",
      "$value": "{color.bg.subtle}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.text.primary}"
    },
    "muted": {
      "$type": "color",
      "$value": "{color.text.secondary}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.border.default}"
    },
    "border-strong": {
      "$type": "color",
      "$value": "{color.border.strong}"
    },
    "info-bg": {
      "$type": "color",
      "$value": "{color.info.soft}"
    },
    "on-accent": {
      "$type": "color",
      "$value": "{color.text.on-accent}",
