    "reading-max": {
      "$type": "dimension",
      "$value": "720px",
      "$description": "Max width of forms and long text"
    }
  },
  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": "640px"
    },
    "md": {
      "$type": "dimension",
      "$value": "768px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1024px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1280px"
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": "120ms",
      "$description": "Hover, focus, toggles"
    },
    "base": {
      "$type": "duration",
      "$value": "180ms",
      "$description": "Menus, popovers, toasts"
    },
    "slow": {
      "$type": "duration",
      "$value": "260ms",
      "$description": "Sheets, dialogs, widget panel open"
    }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$type": "cubicBezier",
      "$value": [
        0.05,
        0.7,
        0.1,
        1
      ]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [
        0.3,
        0,
        0.8,
        0.15
      ]
    }
  },
