    "lg": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Cards, panels, popovers"
    },
    "xl": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Dialogs, sheets, chat bubbles"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Pills, avatars, toggle"
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "#0F17201A",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      },
      "$description": "Raised buttons, sticky bars",
      "$extensions": {
        "org.kakiagent.modes": {
          "dark": {
            "color": "#00000066",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px"
          }
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "#0F17201F",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "-2px"
      },
      "$description": "Popovers, menus, toasts",
      "$extensions": {
        "org.kakiagent.modes": {
          "dark": {
            "color": "#00000080",
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "12px",
            "spread": "-2px"
          }
        }
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "#0F172029",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "-4px"
