      "$type": "dimension",
      "$value": "32px",
      "$description": "Compact buttons in tables (pointer devices only)"
    },
    "control-md": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "Default button and input height on pointer devices"
    },
    "control-lg": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "Default on touch (pointer: coarse); minimum touch target"
