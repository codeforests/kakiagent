            "dark": "#33270C"
          }
        }
      }
    },
    "danger": {
      "default": {
        "$type": "color",
        "$value": "#B91C1C",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#F87171"
          }
        }
      },
      "hover": {
        "$type": "color",
        "$value": "#991B1B",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#FCA5A5"
          }
        }
      },
      "soft": {
        "$type": "color",
        "$value": "#FCE9E9",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#3A1616"
          }
        }
      }
    },
    "info": {
      "default": {
        "$type": "color",
        "$value": "#1D4ED8",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#93B4FF"
          }
        }
      },
      "soft": {
        "$type": "color",
        "$value": "#E8EEFC",
        "$extensions": {
          "org.kakiagent.modes": {
            "dark": "#18233F"
          }
        }
      }
